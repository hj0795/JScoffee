rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 관리자 계정 등록은 Firebase 콘솔에서만 합니다.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function validRecord() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion', 'version', 'payload', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.version is int
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 800000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    match /school/current {
      allow get: if true;
      allow list, delete: if false;
      allow create: if isAdmin() && validRecord()
        && request.resource.data.version == 1;
      allow update: if isAdmin() && validRecord()
        && request.resource.data.version == resource.data.version + 1;
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
